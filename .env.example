# Example local KataGo runtime configuration
# Copy this file to .env and adjust the paths for your machine.

# Path to the KataGo binary to run for analysis.
KATAGO=/root/katago_bin/katago-cuda

# Path to the neural network model file used by KataGo.
MODEL=/root/katago_bin/kata1-zhizi-b40c768nbt-s11272M-d5935M.bin.gz

# Main analysis config file used for the benchmark run.
CONFIG=/root/katago_bin/analysis_example.cfg

# Base config copied into each case directory before overrides are applied.
BASE_CONFIG=/root/katago_bin/analysis_example.cfg

# Input request file containing positions to analyze.
REQUESTS=/root/deepgo-module0-katago-feature-store/example_store/requests.jsonl

# Directory where benchmark outputs and per-case logs will be written.
OUT_ROOT=/root/deepgo-module0-katago-feature-store/analysis_logs/quick_param_tuning

# How long each benchmark case should run, in seconds.
# Use a number greater than 0 to stop after that many seconds.
# Use 0 or a negative value to let the process run until it finishes.
SECONDS_PER_CASE=300

# Optional CUDA tuning. Leave empty to auto-detect visible GPUs.
# Example for a 2-GPU box: CUDA_DEVICE_IDS=0,1
CUDA_DEVICE_IDS=0

# Number of neural-network server threads to use per model.
CUDA_NUM_NN_SERVER_THREADS_PER_MODEL=1

# Whether to use FP16 on CUDA. Set to auto or true/false as needed.
CUDA_USE_FP16=auto

# Ensure the conda runtime can find cuDNN.
LD_LIBRARY_PATH=/root/miniforge3/envs/katago-gpu/lib:${LD_LIBRARY_PATH:-}
